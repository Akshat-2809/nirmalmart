# ─── Database ───
# Local docker compose uses these; in production set DATABASE_URL to the Supabase
# "Session pooler" connection string (Project Settings → Database → Connection string).
POSTGRES_USER=nirmalmart
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nirmalmart
DATABASE_URL=postgresql://nirmalmart:change_me@db:5432/nirmalmart

# ─── App ───
APP_NAME=NirmalMart
APP_ENV=development            # set to "production" when deployed
CORS_ORIGINS=http://localhost:5173

# ─── Auth ───  generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_USERNAME=nirmalmartadmin     # owner account, created on first start if missing
ADMIN_EMAIL=admin@nirmalmart.com    # owner can sign in with username or email
ADMIN_PASSWORD=                     # required; set a strong password

# ─── Image storage ───  "local" for dev, "supabase" in production
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=product-images

# ─── Google Gemini (AI product listings; optional) ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Razorpay (pending: awaiting client's keys) ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Shiprocket (courier shipping; leave empty to ship manually) ───
# Use the API user from Shiprocket → Settings → API (not the main account login)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
# Any long random string; paste the same value as the token on Shiprocket's tracking webhook
SHIPROCKET_WEBHOOK_TOKEN=
